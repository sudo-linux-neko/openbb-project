    "TLT",
    "SHY"
  ],
  "hedge_weights": [
    0.5,
    0.5
  ],
  "vol_target_ann": 0.1,
  "vol_window": 60,
  "max_gross": 1.0,
  "min_gross": 0.0,
  "max_name_weight": 0.05,
  "cost_bps_per_side": 5.0,
  "slippage_bps": 1.0,
  "benchmark_weights": {
    "SPY": 0.6,
    "AGG": 0.4
  },
  "train_years": 5,
  "test_years": 1,
  "purge_days": 21,
  "n_bootstrap": 1000,
  "cache_dir": "data_cache",
  "results_dir": "results",
  "batch_size": 20,
  "request_pause": 0.5,
  "max_retries": 3
